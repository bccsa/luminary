#!/usr/bin/env bash
# Block pushing a branch whose luminary-media-convert pointer would revert main's on merge.
set -euo pipefail
check="$(git rev-parse --show-toplevel)/scripts/check-submodule-pointer.sh"
git fetch -q origin main 2>/dev/null || true
zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [[ "$local_sha" == "$zero" ]] && continue # branch deletion
    "$check" --ref "$local_sha"
done
