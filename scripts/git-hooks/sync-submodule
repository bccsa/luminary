#!/usr/bin/env bash
# Shared by post-checkout and post-merge: move a clean luminary-media-convert checkout to the
# pointer the new HEAD records, so a stale checkout never sits there waiting to be committed.
set -euo pipefail
SUB="luminary-media-convert"
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Rebases fire post-checkout per commit; the final checkout is the one that matters.
for dir in rebase-merge rebase-apply; do
    [[ -d "$(git rev-parse --git-path "$dir")" ]] && exit 0
done
[[ -e "$SUB/.git" ]] || exit 0 # not initialised in this worktree

recorded="$(git ls-tree HEAD -- "$SUB" | awk '{ print $3 }')"
current="$(git -C "$SUB" rev-parse HEAD 2>/dev/null || true)"
[[ -z "$recorded" || "$recorded" == "$current" ]] && exit 0

if [[ -n "$(git -C "$SUB" status --porcelain)" ]]; then
    printf '\033[1;33m[submodule]\033[0m %s has local changes; left at %s (HEAD records %s).\n' \
        "$SUB" "${current:0:7}" "${recorded:0:7}" >&2
    exit 0
fi
printf '\033[1;34m[submodule]\033[0m %s %s → %s\n' "$SUB" "${current:0:7}" "${recorded:0:7}" >&2
git submodule update -q -- "$SUB" || true
