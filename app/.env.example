VITE_APP_NAME="Luminary App"

# Optional logo overrides. Leave unset to use the bundled default logos.
# When set, the value is used verbatim as the image URL at runtime, so it must
# be an absolute https URL (or a path served by the deployed site). Source-tree
# paths like ../src/assets/... only resolve in the dev server and break in
# production and native builds.
#VITE_LOGO="https://example.com/logo.svg"
#VITE_LOGO_DARK="https://example.com/logo-dark.svg"
# Logo for smaller screens
#VITE_LOGO_SMALL="https://example.com/logo-small.svg"
#VITE_LOGO_SMALL_DARK="https://example.com/logo-small.svg"
VITE_LOGO_FAVICON="src/assets/favicon.png"

# ID of privacy policy page
VITE_PRIVACY_POLICY_ID="page-privacy-policy"

# Allowed Matomo servers (JSON array). Using quotes avoids parsing surprises across shells/tools.
VITE_ALLOWED_MATOMO_SERVERS='["https://localhost:8081"]'
VITE_MATOMO_SERVER=http://localhost:8080
VITE_ANALYTICS_HOST="http://localhost:8080"
VITE_ANALYTICS_SITEID="1"


# ID of copyright page
VITE_COPYRIGHT_ID="page-copyright"

VITE_API_URL="http://localhost:3000"

# Public WEB origin used by SSG for absolute canonical, Open Graph, hreflang,
# and JSON-LD URLs. Set this to the deployed public origin per environment.
VITE_WEB_ORIGIN="https://app.example.com"

# Public organization identity used in article and WebSite JSON-LD. The logo
# path is resolved against VITE_WEB_ORIGIN and must be publicly accessible.
VITE_PUBLIC_ORGANIZATION_NAME="Luminary"
VITE_PUBLIC_LOGO_PATH="/logo.svg"

VITE_SENTRY_DSN=

# URL scheme the packaged native app is registered for (login callback URIs are
# built under it). Defaults to the Active Christianity app id when unset.
#VITE_APP_URL_SCHEME="africa.activechristianity.app"


# Optional — debugging aid only. Set to "true" to disable minification (readable
# build output); any other value (or unset) minifies normally.
VITE_BYPASS_MINIFY=false
