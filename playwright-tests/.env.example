# Copy to .env and fill in. Never commit the real .env file.

# Base URLs for the environments under test
APP_BASE_URL=
CMS_BASE_URL=

# Dedicated test user credentials on the auth provider backing the deployments
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# ── Local ephemeral stack (fake OIDC issuer) ────────────────────────────────
# Set E2E_COUCHDB_URL to opt into the fake-IdP flow. Global setup then starts a
# local issuer, registers it as an AuthProvider, and specs sign in per test via
# the persona fixture instead of logging in through a real provider.
# E2E_USER_EMAIL / E2E_USER_PASSWORD are not used in this mode.
E2E_COUCHDB_URL=
E2E_COUCHDB_DATABASE=luminary
E2E_IDP_PORT=8099
E2E_API_URL=http://localhost:3000
# Overrides the worker count in fake-IdP mode (default 4 in CI, Playwright's default locally).
E2E_WORKERS=
# The API under test must run with AUTH_ALLOW_INSECURE_PROVIDER_DOMAIN=true, or it
# will reject the local issuer's tokens.
