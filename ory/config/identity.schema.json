{
    "$id": "https://luminary.bcc.no/schemas/guest.schema.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Luminary guest",
    "type": "object",
    "properties": {
        "traits": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email",
                    "title": "Email address",
                    "minLength": 3,
                    "ory.sh/kratos": {
                        "credentials": {
                            "code": {
                                "identifier": true,
                                "via": "email"
                            }
                        },
                        "verification": {
                            "via": "email"
                        },
                        "recovery": {
                            "via": "email"
                        }
                    }
                },
                "name": {
                    "type": "string",
                    "title": "Name"
                }
            },
            "required": ["email"],
            "additionalProperties": false
        }
    }
}
